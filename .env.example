# ── Olivone — variables d'environnement (EXEMPLE) ────────────────────────────
# Copier en .env et adapter. Le fichier .env est ignoré par Git :
# NE JAMAIS committer de vraie valeur secrète.
#
# En production (docker-compose.yml), OLIVONE_ENV/BIND/DATA_DIR/WEB_DIR sont
# déjà fixés par le compose : seules comptent ici les 4 variables du bloc
# « Secrets & production » ci-dessous.

# ── Dev local ────────────────────────────────────────────────────────────────
OLIVONE_ENV=dev
OLIVONE_BIND=:8080
OLIVONE_DATA_DIR=./data
OLIVONE_WEB_DIR=

# ── Secrets & production ─────────────────────────────────────────────────────
# URL publique (https, derrière SWAG).
OLIVONE_BASE_URL=https://olivone.mondomaine.tld

# Clé maître pour chiffrer les secrets par utilisateur (Mistral, e-mail).
# 32 octets encodés en base64. Générer avec :  openssl rand -base64 32
# OBLIGATOIRE en production. En dev, si absente, une clé éphémère est générée.
# ⚠️ Si tu la changes, les secrets déjà enregistrés deviennent illisibles.
OLIVONE_MASTER_KEY=

# Compte administrateur créé au tout premier démarrage (bootstrap).
# Choisis un mot de passe fort ; il ne sert qu'à la première connexion.
OLIVONE_ADMIN_EMAIL=attadeurtia@vivaldi.net
OLIVONE_ADMIN_PASSWORD=change-moi

# ── Optionnel ────────────────────────────────────────────────────────────────
# Fréquence de vérification des relances automatiques (défaut 1h). Ex. 30m, 6h.
# OLIVONE_FOLLOWUP_CHECK_INTERVAL=1h
